<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_ERR">
      <PatternLayout pattern="[jooq-codegen] %level %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <!-- suppress JOOQ's verbose codegen log output -->
    <Logger name="org.jooq" level="WARN" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <Root level="WARN">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
